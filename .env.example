# No secret is required for the default RSS and SEC connectors.
NEWS_AGENT_MODE=live
NEWS_AGENT_MODEL=qwen2.5:7b
NEWS_AGENT_OLLAMA_URL=http://localhost:11434
NEWS_AGENT_USE_OLLAMA=true
NEWS_AGENT_WATCHLIST=config/watchlist.json
NEWS_AGENT_DATA_DIR=data

# SEC asks automated clients to identify themselves. Live mode requires your real contact.
# This is contact information, not an API key.
SEC_USER_AGENT=FinancialNewsAgent/1.0 your-email@example.com
